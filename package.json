{
  "name": "oturead",
  "module": "src/index.tsx",
  "type": "module",
  "private": true,
  "bin": {
    "oturead": "src/index.tsx"
  },
  "scripts": {
    "dev": "bun run src/index.tsx",
    "demo": "bun run src/index.tsx --simulate examples/showcase.md",
    "build": "bun build --compile src/index.tsx --outfile dist/oturead",
    "typecheck": "tsc --noEmit",
    "snapshot": "bun scripts/snapshot.tsx",
    "test": "bun test"
  },
  "dependencies": {
    "@opentui/core": "^0.5.2",
    "@opentui/react": "^0.5.2",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.0",
    "marked": "17.0.1",
    "typescript": "^5"
  }
}
